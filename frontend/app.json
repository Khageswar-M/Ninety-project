{
  "expo": {
    "name": "Ninety",
    "slug": "ninety",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/NinetyAppLogo.png",
    "scheme": "ninety",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icons/NinetyAppLogo.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.config.ninety"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/NinetyAppLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/NinetyAppLogo.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d4420c1-467b-46a5-b545-9f10a2882ef8"
      }
    },
    "owner": "khageswar"
  }
}
