# Local development values only. Replace secrets before using any shared environment.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ninety
DB_USERNAME=ninety
DB_PASSWORD=change-this-local-db-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password

REDIS_HOST=localhost
