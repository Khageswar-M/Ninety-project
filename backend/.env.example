JWT_ACCESS_EXP=900000
JWT_REFRESH_EXP=604800000
OTP_EXPIRY_MIN=5
OTP_LENGTH=6

RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL=replace-with-a-verified-sender@example.com
GEMINI_API_KEY=replace-with-your-gemini-api-key
